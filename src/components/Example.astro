---
import { evidenceHref } from '../../scripts/lib/example-parse.mjs';

interface Props {
  label: 'Observed' | 'Computed' | 'Constructed';
  task: string;
  evidence?: string;
  env?: string;
}

const { label, task, evidence, env } = Astro.props;
const links = label === 'Observed' ? (evidence ?? '').split(/\s+/).filter(Boolean) : [];
---

<section class={`ahg-example border-${label.toLowerCase()}`} aria-label={`Example, ${label}: ${task}`}>
  <div class="ex-topbar">
    <div class="ex-badge-group">
      <span class={`ex-chip ex-${label.toLowerCase()}`}>{label}</span>
      {env && <span class="ex-env">{env}</span>}
    </div>
    {
      (links.length > 0 || (label === 'Computed' && evidence)) && (
        <p class="ex-evidence">
          Evidence:{' '}
          {links.length > 0
            ? links.map((item, i) => (
                <>
                  {i > 0 && ' '}
                  <a href={evidenceHref(item)}>{item.replace(/^https:\/\/github\.com\/GlenTiki\/agentic-harness-guide\/blob\/main\//, '')}</a>
                </>
              ))
            : evidence}
        </p>
      )
    }
  </div>

  <div class="ex-section ex-task-section">
    <p class="ex-h"><span class="section-icon">🎯</span> Task</p>
    <p class="ex-task">{task}</p>
  </div>

  <div class="ex-section">
    <p class="ex-h"><span class="section-icon">📥</span> Input</p>
    <div class="ex-block"><slot name="input" /></div>
  </div>

  <div class="ex-section">
    <p class="ex-h"><span class="section-icon">📤</span> Output</p>
    <div class="ex-block"><slot name="output" /></div>
  </div>

  <div class="ex-section">
    <p class="ex-h"><span class="section-icon">👀</span> What to notice</p>
    <div class="ex-text"><slot name="notice" /></div>
  </div>

  <div class="ex-section">
    <p class="ex-h"><span class="section-icon">💡</span> What it shows</p>
    <div class="ex-text"><slot name="shows" /></div>
  </div>
</section>

<style>
  .ahg-example {
    margin: 1.75rem 0;
    padding: 1.15rem;
    min-width: 0;
    background: var(--ahg-panel);
    color: var(--ahg-text);
    border: 1px solid var(--ahg-line);
    border-left: 4px solid var(--ahg-line);
    border-radius: var(--ahg-radius-card);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.04);
  }

  .border-observed { border-left-color: var(--ahg-accent); }
  .border-computed { border-left-color: var(--ahg-atwork); }
  .border-constructed { border-left-color: var(--ahg-expert); }

  .ex-topbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.65rem;
    margin-bottom: 0.85rem;
    border-bottom: 1px solid var(--ahg-line);
  }

  .ex-badge-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .ex-chip {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: var(--sl-text-xs);
    font-weight: 700;
  }

  .ex-observed { color: var(--ahg-accent-strong); background: var(--ahg-accent-soft); }
  .ex-computed { color: var(--ahg-atwork); background: var(--ahg-atwork-soft); }
  .ex-constructed { color: var(--ahg-expert); background: var(--ahg-expert-soft); }

  .ex-env {
    font-size: var(--sl-text-xs);
    color: var(--ahg-muted);
  }

  .ex-evidence {
    margin: 0;
    font-size: var(--sl-text-xs);
    color: var(--ahg-muted);
  }

  .ex-section {
    margin-top: 0.75rem;
  }

  .ex-h {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0 0 0.25rem;
    font-size: var(--sl-text-xs);
    font-weight: 700;
    color: var(--ahg-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .section-icon {
    font-size: 13px;
  }

  .ex-task {
    margin: 0;
    font-size: var(--ahg-text-body);
    font-weight: 600;
    color: var(--ahg-text);
  }

  .ex-block, .ex-text {
    min-width: 0;
  }

  .ex-block :global(.expressive-code) {
    margin-block: 0.35rem;
  }

  .ex-text :global(p) {
    margin: 0.25rem 0;
    font-size: var(--ahg-text-body);
  }
</style>
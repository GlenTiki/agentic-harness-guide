---
import { getCollection } from 'astro:content';
import { BASE } from '../data/site';
import trialResults from '../../examples/wrong-behaviour/results.json';

const { data } = Astro.props.entry || { data: {} };
const hero = data?.hero || {};
const title = hero.title || 'Harness the power of your AI companions.';
const tagline =
  hero.tagline ||
  'A practical guide to getting dependable work from AI assistants. Sound engineering discipline for everyday builders, with deep technical reference shelves for software engineers.';
const recordedTrials = trialResults.reduce((sum, arm) => sum + arm.n, 0);
const shelfAndWorkflowPages = (await getCollection('docs')).filter(
  (entry) => entry.id.startsWith('shelf/') || entry.id.startsWith('workflows/'),
).length;
---

<header class="harness-hero" aria-label="Introduction">
  <div class="hero-kicker-row">
    <div class="kicker-badge">
      <span class="kicker-dot" aria-hidden="true"></span>
      <span class="kicker-text">OPEN-SOURCE FIELD GUIDE</span>
    </div>
    <div class="kicker-formula" aria-label="Core formula: Agent equals Model plus Harness">
      <span class="formula-term">Agent</span>
      <span class="formula-op">=</span>
      <span class="formula-term">Model</span>
      <span class="formula-op">+</span>
      <span class="formula-term formula-highlight">Harness</span>
    </div>
  </div>

  <h1 id="_top" class="hero-title">{title}</h1>

  <p class="hero-tagline">{tagline}</p>

  <div class="hero-author-card">
    <div class="author-avatar" aria-hidden="true">GK</div>
    <div class="author-details">
      <div class="author-byline">
        <span class="author-name">Glen Keane</span>
        <span class="author-badge">AI ENGINEER</span>
      </div>
      <p class="author-bio">
        Formerly Wayflyer and Nearform. Currently building production AI systems for regulated enterprise clients (AXA, Zurich) at Brightbeam.
      </p>
    </div>
  </div>

  <div class="hero-actions-row">
    <a href={`${BASE}/method/be-the-product-manager-of-your-own-tooling/`} class="hero-btn btn-primary">
      <span>The Product Manager Method</span>
      <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
    <a href={`${BASE}/start-here/engineer-route/`} class="hero-btn btn-secondary">
      <span>For Engineers (Deep Dive)</span>
    </a>
    <a href={`${BASE}/start-here/why-bother/`} class="hero-btn btn-minimal">
      <span>Why Bother (The 80% Trap)</span>
    </a>
  </div>

  <div class="hero-pillars-grid">
    <div class="pillar-card">
      <div class="pillar-header">
        <span class="pillar-num">01</span>
        <h2 class="pillar-title">Product Manager Mindset</h2>
      </div>
      <p class="pillar-text">
        Direct high-level intent and define clear pass/fail criteria. Treat the model like a capable junior contractor: set boundaries and verify deliverables.
      </p>
    </div>

    <div class="pillar-card">
      <div class="pillar-header">
        <span class="pillar-num">02</span>
        <h2 class="pillar-title">Mechanical Verification</h2>
      </div>
      <p class="pillar-text">
        Never trust unchecked claims. Use spreadsheet formulas, checks, or unit tests to catch mistakes before sign-off. If a check fails, the work halts.
      </p>
    </div>

    <div class="pillar-card">
      <div class="pillar-header">
        <span class="pillar-num">03</span>
        <h2 class="pillar-title">Disposable Micro-Tools</h2>
      </div>
      <p class="pillar-text">
        Turn recurring chores into small, focused tools in an afternoon. If a tool works, keep it. If your needs change, build the next one without hesitation.
      </p>
    </div>
  </div>

  <div class="hero-proof-bar" role="list" aria-label="Key handbook metrics">
    <div class="proof-chip" role="listitem">
      <span class="proof-dot"></span>
      <span class="proof-label"><strong>{recordedTrials}</strong> Recorded Trials</span>
    </div>
    <div class="proof-chip" role="listitem">
      <span class="proof-dot"></span>
      <span class="proof-label"><strong>{shelfAndWorkflowPages}</strong> Shelf & Workflow Pages</span>
    </div>
    <div class="proof-chip" role="listitem">
      <span class="proof-dot"></span>
      <span class="proof-label"><strong>0</strong> External SaaS Dependencies</span>
    </div>
    <div class="proof-chip" role="listitem">
      <span class="proof-dot"></span>
      <span class="proof-label"><strong>CC BY 4.0</strong> Text, MIT Code</span>
    </div>
  </div>
</header>

<style>
  .harness-hero {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 1.5rem 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .hero-kicker-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .kicker-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    background: var(--ahg-accent-soft);
    border: 1px solid var(--ahg-accent);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--ahg-accent-strong);
    white-space: nowrap;
  }

  .kicker-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ahg-accent);
  }

  .kicker-formula {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--ahg-radius-control);
    background: var(--ahg-panel);
    border: 1px solid var(--ahg-line);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--ahg-muted);
    white-space: nowrap;
  }

  .formula-highlight {
    color: var(--ahg-right);
    font-weight: 800;
  }

  .hero-title {
    font-size: clamp(2.2rem, 5.2vw, 3.5rem);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.035em;
    color: var(--ahg-text);
    margin: 0;
    max-width: 52rem;
  }

  .hero-tagline {
    font-size: clamp(1.02rem, 2vw, 1.2rem);
    line-height: 1.55;
    color: var(--ahg-muted);
    margin: 0;
    max-width: 48rem;
  }

  .hero-author-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 1rem;
    border-radius: var(--ahg-radius-card);
    background: var(--ahg-panel);
    border: 1px solid var(--ahg-line);
    max-width: fit-content;
    box-sizing: border-box;
  }

  .author-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--ahg-accent-soft);
    border: 1.5px solid var(--ahg-accent);
    color: var(--ahg-accent-strong);
    font-weight: 800;
    font-size: 0.82rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .author-details {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .author-byline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .author-name {
    font-weight: 800;
    font-size: 0.88rem;
    color: var(--ahg-text);
  }

  .author-badge {
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    background: var(--ahg-atwork-soft);
    color: var(--ahg-atwork);
    border: 1px solid var(--ahg-atwork);
  }

  .author-bio {
    margin: 0.2rem 0 0;
    font-size: 0.78rem;
    color: var(--ahg-muted);
    line-height: 1.4;
  }

  .author-bio code {
    font-size: 0.74rem;
    padding: 0.1rem 0.3rem;
    background: var(--ahg-code-bg);
    border-radius: 3px;
  }

  .hero-actions-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    height: 44px;
    padding: 0 1.25rem;
    border-radius: var(--ahg-radius-control);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    box-sizing: border-box;
    transition: all 0.15s ease-out;
  }

  .btn-primary {
    background: var(--ahg-accent);
    color: var(--ahg-accent-ink) !important;
  }

  .btn-primary:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: var(--ahg-panel);
    border: 1px solid var(--ahg-line);
    color: var(--ahg-text) !important;
  }

  .btn-secondary:hover {
    border-color: var(--ahg-accent);
    color: var(--ahg-accent) !important;
  }

  .btn-minimal {
    background: transparent;
    color: var(--ahg-muted) !important;
    padding: 0 0.85rem;
  }

  .btn-minimal:hover {
    color: var(--ahg-text) !important;
    text-decoration: underline;
  }

  .btn-arrow {
    flex-shrink: 0;
  }

  .hero-pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 0.6rem;
  }

  .pillar-card {
    background: var(--ahg-panel);
    border: 1px solid var(--ahg-line);
    border-radius: var(--ahg-radius-card);
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    box-sizing: border-box;
  }

  .pillar-header {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .pillar-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--ahg-accent);
  }

  .pillar-title {
    font-size: 0.92rem;
    font-weight: 800;
    color: var(--ahg-text);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .pillar-text {
    font-size: 0.8rem;
    color: var(--ahg-muted);
    line-height: 1.46;
    margin: 0;
  }

  .hero-proof-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1.5rem;
    padding: 0.75rem 1rem;
    border-radius: var(--ahg-radius-control);
    background: var(--ahg-panel);
    border: 1px dashed var(--ahg-line);
    font-size: 0.76rem;
    color: var(--ahg-muted);
    box-sizing: border-box;
  }

  .proof-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .proof-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ahg-right);
    flex-shrink: 0;
  }

  @media (max-width: 860px) {
    .hero-pillars-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 580px) {
    .hero-title {
      font-size: 2.1rem;
    }
    .hero-kicker-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .hero-actions-row {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-btn {
      width: 100%;
    }
    .hero-proof-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
  }
</style>

---
import { BASE } from '../data/site';
---

<section class="landing-flow" data-component="landing-flow" aria-labelledby="flow-heading">
  <!-- Top Navigation & Header -->
  <div class="flow-header">
    <div class="flow-title-row">
      <span class="flow-live-pill" data-live-pill>
        <span class="pulse-dot"></span>
        <span class="live-label" data-live-label>COMPOUNDING FLYWHEEL ACTIVE</span>
      </span>
      <h2 id="flow-heading" class="flow-heading" data-flow-heading>
        How to be the Product Manager of your own tooling
      </h2>
      <p class="flow-lead" data-flow-lead>
        Direct intent, let the assistant build and test the tool, and keep the capability forever.
      </p>
    </div>

    <div class="flow-mode-switch" role="group" aria-label="Tooling philosophy scenario">
      <button type="button" class="mode-btn active" data-mode="flywheel">
        <span class="mode-icon">⚡</span>
        <span class="mode-text">The Compounding Flywheel</span>
      </button>
      <button type="button" class="mode-btn" data-mode="hamster">
        <span class="mode-icon">🔄</span>
        <span class="mode-text">The Prompting Hamster Wheel</span>
      </button>
    </div>
  </div>

  <!-- Interactive Stage (Two Panes on Desktop, Stacked on Mobile) -->
  <div class="flow-stage-grid">
    <!-- Left Pane: The Working Paper / Live Data Desk -->
    <div class="flow-pane desk-pane">
      <div class="pane-header">
        <div class="pane-title-group">
          <span class="pane-icon" data-desk-icon>📋</span>
          <span class="pane-title" data-desk-title>Working Paper: Monday Invoices</span>
        </div>
        <span class="desk-badge badge-ok" data-desk-badge>WEEK 1: RAW INGEST</span>
      </div>

      <div class="desk-viewport" data-desk-viewport>
        <div class="desk-content" data-desk-content>
          <pre class="desk-pre"><code class="desk-code" data-desk-code>Loading simulation...</code></pre>
        </div>
      </div>

      <div class="desk-telemetry">
        <div class="telemetry-item">
          <span class="telem-label">Output status:</span>
          <span class="telem-val val-warn" data-telem-status>UNVERIFIED RAW DATA</span>
        </div>
        <div class="telemetry-item">
          <span class="telem-label">Runtime:</span>
          <span class="telem-val" data-telem-time>Manual courier (12 min)</span>
        </div>
      </div>
    </div>

    <!-- Right Pane: The Product Manager Flywheel / Steering Console -->
    <div class="flow-pane console-pane">
      <div class="pane-header">
        <div class="pane-title-group">
          <span class="pane-icon">🎯</span>
          <span class="pane-title">The Product Manager Flywheel</span>
        </div>
        <span class="console-step-pill" data-step-pill>STEP 1 OF 4</span>
      </div>

      <div class="flywheel-steps" role="tablist" aria-label="Flywheel sequence steps">
        <button type="button" class="step-card active" data-step-target="1" role="tab" aria-selected="true">
          <div class="step-card-num">01</div>
          <div class="step-card-body">
            <strong class="step-card-title" data-step-title="1">Notice Friction</strong>
            <p class="step-card-desc" data-step-desc="1">Messy supplier amounts with mixed currency labels and duplicate rows.</p>
          </div>
        </button>

        <button type="button" class="step-card" data-step-target="2" role="tab" aria-selected="false">
          <div class="step-card-num">02</div>
          <div class="step-card-body">
            <strong class="step-card-title" data-step-title="2">Steer with Intent</strong>
            <p class="step-card-desc" data-step-desc="2">Tell the assistant what to build. Skip the code; specify the outcome.</p>
          </div>
        </button>

        <button type="button" class="step-card" data-step-target="3" role="tab" aria-selected="false">
          <div class="step-card-num">03</div>
          <div class="step-card-body">
            <strong class="step-card-title" data-step-title="3">Assistant Proves Fix</strong>
            <p class="step-card-desc" data-step-desc="3">Tech lead writes a 12-line helper in a worktree and runs a red test.</p>
          </div>
        </button>

        <button type="button" class="step-card" data-step-target="4" role="tab" aria-selected="false">
          <div class="step-card-num">04</div>
          <div class="step-card-body">
            <strong class="step-card-title" data-step-title="4">Keep and Compound</strong>
            <p class="step-card-desc" data-step-desc="4">Save to toolbelt. Next Monday runs in 0.02s with zero prompt overhead.</p>
          </div>
        </button>
      </div>

      <div class="console-narrative-card">
        <div class="narrative-role-chip" data-narrative-role>ROLE: PRODUCT MANAGER</div>
        <p class="narrative-body" data-narrative-text>
          Sam notices 40 receipts from Mina's candle shop with mixed formats (EUR, euro) and a repeated delivery line.
        </p>
      </div>
    </div>
  </div>

  <!-- Bottom Rack: The Persistent Toolbelt & Compounding Dividend -->
  <div class="toolbelt-rack">
    <div class="toolbelt-header">
      <div class="toolbelt-title-group">
        <span class="toolbelt-label">YOUR DURABLE TOOLBELT</span>
        <span class="toolbelt-sub">Capabilities built once, verified with tests, retained forever</span>
      </div>
      <div class="toolbelt-metrics">
        <span class="metric-pill">
          <span class="metric-num" data-metric-saved>2.5 hrs</span>
          <span class="metric-txt">saved weekly</span>
        </span>
        <span class="metric-pill">
          <span class="metric-num" data-metric-retained>3 tools</span>
          <span class="metric-txt">in toolbelt</span>
        </span>
      </div>
    </div>

    <div class="toolbelt-items" data-toolbelt-items>
      <!-- Populated by JavaScript with fixed 4-slot geometry -->
    </div>
  </div>

  <!-- Playback and Deep Dive Controls -->
  <div class="flow-bottom-bar">
    <div class="playback-controls">
      <button type="button" class="ctrl-btn" data-action="toggle-playback">
        <span class="ctrl-icon" data-play-icon>⏸</span>
        <span data-play-text>Pause</span>
      </button>
      <button type="button" class="ctrl-btn" data-action="step-playback">
        <span>Next Step ⏭</span>
      </button>
      <button type="button" class="ctrl-btn" data-action="reset-playback">
        <span>Restart ↺</span>
      </button>
    </div>

    <div class="flow-guide-link">
      <a href={`${BASE}/method/be-the-product-manager-of-your-own-tooling/`} data-guide-link>
        Read the Product Manager method →
      </a>
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('[data-component="landing-flow"]');
    if (!root) return;

    const modeBtns = root.querySelectorAll('[data-mode]');
    const stepCards = root.querySelectorAll('[data-step-target]');
    const liveLabel = root.querySelector('[data-live-label]');
    const livePill = root.querySelector('[data-live-pill]');
    const flowHeading = root.querySelector('[data-flow-heading]');
    const flowLead = root.querySelector('[data-flow-lead]');
    const deskIcon = root.querySelector('[data-desk-icon]');
    const deskTitle = root.querySelector('[data-desk-title]');
    const deskBadge = root.querySelector('[data-desk-badge]');
    const deskCode = root.querySelector('[data-desk-code]');
    const telemStatus = root.querySelector('[data-telem-status]');
    const telemTime = root.querySelector('[data-telem-time]');
    const stepPill = root.querySelector('[data-step-pill]');
    const narrativeRole = root.querySelector('[data-narrative-role]');
    const narrativeText = root.querySelector('[data-narrative-text]');
    const metricSaved = root.querySelector('[data-metric-saved]');
    const metricRetained = root.querySelector('[data-metric-retained]');
    const toolbeltItems = root.querySelector('[data-toolbelt-items]');
    const playBtn = root.querySelector('[data-action="toggle-playback"]');
    const playIcon = root.querySelector('[data-play-icon]');
    const playText = root.querySelector('[data-play-text]');
    const stepBtn = root.querySelector('[data-action="step-playback"]');
    const resetBtn = root.querySelector('[data-action="reset-playback"]');
    const guideLink = root.querySelector('[data-guide-link]');

    let currentMode = 'flywheel';
    let currentStep = 1;
    let isPlaying = true;
    let timer = null;

    const scenarios = {
      flywheel: {
        pillLabel: 'COMPOUNDING FLYWHEEL ACTIVE',
        heading: 'How to be the Product Manager of your own tooling',
        lead: 'Direct intent, let the assistant build and test the tool, and keep the capability forever.',
        linkText: 'Read the Product Manager method →',
        linkHref: 'method/be-the-product-manager-of-your-own-tooling/',
        savedMetric: '2.5 hrs',
        retainedMetric: '3 tools',
        steps: [
          {
            step: 1,
            title: 'Notice Friction',
            desc: 'Messy supplier amounts with mixed currency labels and duplicate rows.',
            deskIcon: '📋',
            deskTitle: 'Week 1: Messy Invoices (Unstructured)',
            deskBadge: 'WEEK 1: RAW INGEST',
            telemStatus: 'UNVERIFIED RAW DATA',
            telemStatusClass: 'val-warn',
            telemTime: 'Friction point noticed',
            narrativeRole: 'ROLE: PRODUCT MANAGER',
            narrativeText: 'Sam notices 40 receipts from Mina\'s candle shop with mixed formats (EUR, euro) and a repeated delivery charge. Instead of manually retyping rows into Excel every week, Sam treats this friction as a specification.',
            code: [
              '# Raw Monday Ingest (Messy statements):',
              '1. Candles EUR 120.00',
              '2. Glass jars €85.00',
              '3. Wicks 40 euro',
              '4. Delivery EUR 120.00  [⚠️ duplicate line?]',
              '5. Wax supplies EUR 210.00',
              '',
              'Current state: Manual copy-paste Courier'
            ].join('\n'),
            toolbeltState: [
              { name: 'currency_cleaner.py', status: 'pending', detail: 'Designing in step 2...' },
              { name: 'duplicate_guard.sh', status: 'pending', detail: 'Queueing check...' },
              { name: 'month_end_summary.md', status: 'active', detail: 'Plain English brief' },
              { name: 'vat_tie_out.py', status: 'pending', detail: 'Scheduled for later' }
            ]
          },
          {
            step: 2,
            title: 'Steer with Intent',
            desc: 'Tell the assistant what to build. Skip the code; specify the outcome.',
            deskIcon: '💬',
            deskTitle: 'High-Level Brief (Product Intent)',
            deskBadge: 'PM SPECIFICATION',
            telemStatus: 'INTENT CLARIFIED',
            telemStatusClass: 'val-ok',
            telemTime: 'Steering time: 45 sec',
            narrativeRole: 'ROLE: PRODUCT MANAGER → TECH LEAD',
            narrativeText: 'Sam does not write Python or regular expressions. Sam tells the assistant: "Clean up currency symbols, calculate distinct totals, and halt with exit code 1 if any row duplicates." The assistant takes ownership of the technical plan.',
            code: [
              '# User Brief to Assistant (Tech Lead):',
              'Goal: Parse monthly shop invoices without manual cleanup.',
              'Rules:',
              '  1. Normalise EUR, euro, and € to standard float.',
              '  2. Halt immediately if any item description + amount duplicates.',
              '  3. Mina reads the summary: no technical jargon.',
              'Check:',
              '  Write an isolated unit test and prove it catches the duplicate.'
            ].join('\n'),
            toolbeltState: [
              { name: 'currency_cleaner.py', status: 'building', detail: 'Assistant drafting in worktree' },
              { name: 'duplicate_guard.sh', status: 'building', detail: 'Writing failing red test' },
              { name: 'month_end_summary.md', status: 'active', detail: 'Plain English brief' },
              { name: 'vat_tie_out.py', status: 'pending', detail: 'Scheduled for later' }
            ]
          },
          {
            step: 3,
            title: 'Assistant Proves Fix',
            desc: 'Tech lead writes a 12-line helper in a worktree and runs a red test.',
            deskIcon: '⚙️',
            deskTitle: 'Isolated Worktree: Test Gate & Execution',
            deskBadge: 'TEST GATE PASS: EXIT 0',
            telemStatus: 'MECHANICALLY VERIFIED',
            telemStatusClass: 'val-ok',
            telemTime: 'Assistant build: 18 sec',
            narrativeRole: 'ROLE: TECH LEAD (ASSISTANT)',
            narrativeText: 'The assistant works in an isolated git worktree. It writes a 12-line parser, proves it fails on the duplicate delivery line (the red run), and verifies all checks pass before asking Sam for sign-off.',
            code: [
              '# Assistant Output (Tested in isolated branch):',
              '$ python3 test_invoice_cleaner.py',
              '  [TEST 1] Currency normalisation (€/EUR/euro) -> PASS',
              '  [TEST 2] Duplicate line detection -> PASS (caught Row 4)',
              '',
              'CLEAN INVOICE REPORT:',
              '  1. Candles: €120.00',
              '  2. Glass jars: €85.00',
              '  3. Wicks: €40.00',
              '  4. Wax supplies: €210.00',
              '  [!] STOP: Row 4 ("Delivery EUR 120.00") flagged as duplicate.',
              '  Distinct Net Total: €455.00 | Proof exit code: 0'
            ].join('\n'),
            toolbeltState: [
              { name: 'currency_cleaner.py', status: 'active', detail: 'Verified by test suite' },
              { name: 'duplicate_guard.sh', status: 'active', detail: 'Caught duplicate row' },
              { name: 'month_end_summary.md', status: 'active', detail: 'Ready for toolbelt' },
              { name: 'vat_tie_out.py', status: 'pending', detail: 'Scheduled for later' }
            ]
          },
          {
            step: 4,
            title: 'Keep and Compound',
            desc: 'Save to toolbelt. Next Monday runs in 0.02s with zero prompt overhead.',
            deskIcon: '⚡',
            deskTitle: 'Week 2: Autonomous Execution (Next Monday)',
            deskBadge: 'ZERO RE-PROMPTING',
            telemStatus: 'COMPOUNDING DIVIDEND',
            telemStatusClass: 'val-highlight',
            telemTime: 'Runtime: 0.02s (saved 45 min)',
            narrativeRole: 'THE MAGIC: SIMULATE NEXT WEEK',
            narrativeText: 'Sam keeps the tool. Next Monday, 52 fresh invoices arrive. Sam does not open a chat window. The retained micro-tool parses them instantly, catches a supplier duplicate, and outputs the clean tie-out in two hundredths of a second.',
            code: [
              '# Next Monday: 52 fresh receipts loaded automatically',
              '$ ./tools/clean_invoices.py --input receipts_nov.csv',
              '',
              '✓ 52 lines ingested in 0.02s',
              '✓ 3 currency formats normalised to €',
              '⚠️ ANOMALY DETECTED: Row 19 repeats Row 4 ("Wicks €40.00")',
              '✓ Net total reconciled: €1,840.00',
              '',
              'Compounding dividend: Zero prompt fatigue. 45 minutes saved.'
            ].join('\n'),
            toolbeltState: [
              { name: 'currency_cleaner.py', status: 'active', detail: 'Running in production' },
              { name: 'duplicate_guard.sh', status: 'active', detail: 'Running in production' },
              { name: 'month_end_summary.md', status: 'active', detail: 'Reused automatically' },
              { name: 'vat_tie_out.py', status: 'building', detail: 'Next week project' }
            ]
          }
        ]
      },
      hamster: {
        pillLabel: 'WARNING: PROMPTING HAMSTER WHEEL',
        heading: 'The flat-effort trap: babysitting an 80% calculator forever',
        lead: 'Pasting prompts feels fast on day one. On day thirty, you are still fixing the same mistakes.',
        linkText: 'See why prompt engineering alone fails in Why Bother →',
        linkHref: 'start-here/why-bother/',
        savedMetric: '0 hrs',
        retainedMetric: '0 tools',
        steps: [
          {
            step: 1,
            title: 'Vague Raw Prompt',
            desc: 'Pasting unstructured text into a chat box with no constraints or tests.',
            deskIcon: '💬',
            deskTitle: 'Raw Chat Box (No Harness)',
            deskBadge: 'AMATEUR GAMBLING',
            telemStatus: 'UNCHECKED PROMPT',
            telemStatusClass: 'val-warn',
            telemTime: 'Prompting: 5 min',
            narrativeRole: 'ROLE: THE MANUAL COURIER',
            narrativeText: 'Sam pastes 40 invoice lines directly into ChatGPT or Claude with the prompt: "Total these bills please and split 3 ways." There are no schemas, no mechanical checks, and no sandboxes.',
            code: [
              'User prompt:',
              '"Total these bills please and split 3 ways for my shop"',
              '',
              'Pasted lines:',
              'Candles EUR 120, Glass jars €85, Wicks 40 euro, Delivery EUR 120...',
              '',
              'Risk: Model has no external tools or tie-out checks.'
            ].join('\n'),
            toolbeltState: [
              { name: 'no_tools_saved.txt', status: 'failed', detail: 'Ephemeral chat session' },
              { name: 'untracked_history', status: 'failed', detail: 'Lost in context decay' },
              { name: 'manual_retype.xlsx', status: 'failed', detail: 'Zero capabilities built' },
              { name: 'weekly_drag.log', status: 'failed', detail: 'Repeating chores forever' }
            ]
          },
          {
            step: 2,
            title: 'Confident Hallucination',
            desc: 'The model replies with cheerful tone, missing lines and wrong arithmetic.',
            deskIcon: '⚠️',
            deskTitle: 'Model Reply (Confident & Wrong)',
            deskBadge: 'SILENT DRIFT',
            telemStatus: 'WRONG HEADLINE TOTAL',
            telemStatusClass: 'val-danger',
            telemTime: 'Generation: 8 sec',
            narrativeRole: 'SYCOPHANCY IN ACTION',
            narrativeText: 'The assistant sounds entirely confident. It missed "Wicks 40 euro" because of the unusual format, and silently summed the duplicate delivery row. Without a mechanical check, Sam would overpay suppliers.',
            code: [
              'Assistant Reply:',
              '"Here is your clean summary! Everything looks great!',
              'Total expenses: €325.00',
              'Each share: €108.33',
              'Let me know if you need anything else!"',
              '',
              'REALITY CHECK:',
              '  - Completely dropped "Wicks 40 euro" line',
              '  - Included duplicate "Delivery EUR 120" line without warning',
              '  - Arithmetic was wrong by €130.00'
            ].join('\n'),
            toolbeltState: [
              { name: 'no_tools_saved.txt', status: 'failed', detail: 'Ephemeral chat session' },
              { name: 'untracked_history', status: 'failed', detail: 'Lost in context decay' },
              { name: 'manual_retype.xlsx', status: 'failed', detail: 'Zero capabilities built' },
              { name: 'weekly_drag.log', status: 'failed', detail: 'Repeating chores forever' }
            ]
          },
          {
            step: 3,
            title: 'The Babysitting Tax',
            desc: 'Arguing with the model in a 40-minute prompt engineering dispute.',
            deskIcon: '😫',
            deskTitle: 'Chat Disagreement & Review Fatigue',
            deskBadge: 'FATIGUE TAX',
            telemStatus: 'COGNITIVE EXHAUSTION',
            telemStatusClass: 'val-danger',
            telemTime: 'Manual fixing: 35 min',
            narrativeRole: 'ROLE: OVERWORKED HUMAN LINTER',
            narrativeText: 'Sam spots the error and starts arguing: "Wait, you missed the wicks!" The assistant apologises profusely, adjusts one line, but drops another rule. Sam ends up checking every row with a calculator anyway.',
            code: [
              'User: "Wait, you missed the wicks! And delivery was paid twice!"',
              'Assistant: "My apologies! You are completely right! Let me recalculate..."',
              'Assistant: "The revised total is €485.00..." (Now missed Glass jars)',
              '',
              'Result: Sam opens Excel and recalculates by hand.',
              'Comprehension debt: High.',
              'Trust: Destroyed.'
            ].join('\n'),
            toolbeltState: [
              { name: 'no_tools_saved.txt', status: 'failed', detail: 'Ephemeral chat session' },
              { name: 'untracked_history', status: 'failed', detail: 'Lost in context decay' },
              { name: 'manual_retype.xlsx', status: 'failed', detail: 'Zero capabilities built' },
              { name: 'weekly_drag.log', status: 'failed', detail: 'Repeating chores forever' }
            ]
          },
          {
            step: 4,
            title: 'Groundhog Day',
            desc: 'Next Monday arrives with zero retained tools and the exact same drudgery.',
            deskIcon: '🔁',
            deskTitle: 'Next Monday: Zero Compounding',
            deskBadge: 'ZERO RETENTION',
            telemStatus: 'FLAT EFFORT FOREVER',
            telemStatusClass: 'val-danger',
            telemTime: 'Weekly drag: 45 min every week',
            narrativeRole: 'THE 80% CALCULATOR TRAP',
            narrativeText: 'Next Monday brings 50 new receipts. Because Sam treated the assistant as a faster chat keyboard rather than an autonomous toolbuilder, zero tooling was retained. Sam faces the exact same manual chore again.',
            code: [
              '# Next Monday arrives...',
              'Retained micro-tools: 0',
              'Automated test gates: 0',
              'Permanent memory: None',
              '',
              'Process: Open new chat box, paste new prompt, pray for luck.',
              'Compounding dividend: 0%. The hamster wheel keeps spinning.'
            ].join('\n'),
            toolbeltState: [
              { name: 'no_tools_saved.txt', status: 'failed', detail: 'Zero capabilities built' },
              { name: 'untracked_history', status: 'failed', detail: 'Repeating chores forever' },
              { name: 'manual_retype.xlsx', status: 'failed', detail: 'Zero capabilities built' },
              { name: 'weekly_drag.log', status: 'failed', detail: 'Repeating chores forever' }
            ]
          }
        ]
      }
    };

    function renderToolbelt(items) {
      if (!toolbeltItems) return;
      toolbeltItems.innerHTML = items.map((item) => {
        const isAct = item.status === 'active';
        const isBld = item.status === 'building';
        const isFail = item.status === 'failed';
        const cls = isAct ? 'chip-active' : (isBld ? 'chip-building' : (isFail ? 'chip-failed' : 'chip-pending'));
        const icon = isAct ? '✓' : (isBld ? '⚙' : (isFail ? '✗' : '+'));
        return `
          <div class="tool-chip ${cls}">
            <span class="chip-status">${icon}</span>
            <span class="chip-name">${item.name}</span>
            <span class="chip-detail">${item.detail}</span>
          </div>
        `;
      }).join('');
    }

    function renderStep(stepIndex) {
      const scenario = scenarios[currentMode];
      const data = scenario.steps[stepIndex - 1];
      if (!data) return;

      currentStep = stepIndex;

      // Update Header Text
      if (liveLabel) liveLabel.textContent = scenario.pillLabel;
      if (livePill) {
        livePill.classList.toggle('pill-fault', currentMode === 'hamster');
      }
      if (flowHeading) flowHeading.textContent = scenario.heading;
      if (flowLead) flowLead.textContent = scenario.lead;
      if (guideLink) {
        guideLink.textContent = scenario.linkText;
        guideLink.setAttribute('href', `${BASE}/${scenario.linkHref}`);
      }
      if (metricSaved) metricSaved.textContent = scenario.savedMetric;
      if (metricRetained) metricRetained.textContent = scenario.retainedMetric;

      // Update Left Pane (Desk)
      if (deskIcon) deskIcon.textContent = data.deskIcon;
      if (deskTitle) deskTitle.textContent = data.deskTitle;
      if (deskBadge) {
        deskBadge.textContent = data.deskBadge;
        deskBadge.className = `desk-badge ${currentMode === 'hamster' ? 'badge-warn' : 'badge-ok'}`;
      }
      if (deskCode) deskCode.textContent = data.code;
      if (telemStatus) {
        telemStatus.textContent = data.telemStatus;
        telemStatus.className = `telem-val ${data.telemStatusClass || ''}`;
      }
      if (telemTime) telemTime.textContent = data.telemTime;

      // Update Right Pane (Flywheel)
      if (stepPill) stepPill.textContent = `STEP ${data.step} OF 4`;
      if (narrativeRole) narrativeRole.textContent = data.narrativeRole;
      if (narrativeText) narrativeText.textContent = data.narrativeText;

      // Update Step Card Highlights
      stepCards.forEach((card, idx) => {
        const s = idx + 1;
        const isActive = s === currentStep;
        card.classList.toggle('active', isActive);
        card.setAttribute('aria-selected', isActive ? 'true' : 'false');

        const curStepData = scenario.steps[idx];
        const titleEl = card.querySelector('[data-step-title]');
        const descEl = card.querySelector('[data-step-desc]');
        if (titleEl && curStepData) titleEl.textContent = curStepData.title;
        if (descEl && curStepData) descEl.textContent = curStepData.desc;
      });

      // Update Toolbelt
      renderToolbelt(data.toolbeltState);
    }

    function switchMode(mode) {
      currentMode = mode;
      currentStep = 1;
      modeBtns.forEach((b) => {
        b.classList.toggle('active', b.getAttribute('data-mode') === mode);
      });
      renderStep(1);
    }

    function nextStep() {
      const next = currentStep >= 4 ? 1 : currentStep + 1;
      renderStep(next);
    }

    function startTimer() {
      if (timer) clearInterval(timer);
      isPlaying = true;
      if (playIcon) playIcon.textContent = '⏸';
      if (playText) playText.textContent = 'Pause';
      timer = setInterval(nextStep, 6000);
    }

    function pauseTimer() {
      if (timer) clearInterval(timer);
      timer = null;
      isPlaying = false;
      if (playIcon) playIcon.textContent = '▶';
      if (playText) playText.textContent = 'Play';
    }

    // Event Bindings
    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-mode') || 'flywheel';
        switchMode(mode);
      });
    });

    stepCards.forEach((card) => {
      card.addEventListener('click', () => {
        pauseTimer();
        const s = Number(card.getAttribute('data-step-target')) || 1;
        renderStep(s);
      });
    });

    playBtn?.addEventListener('click', () => {
      if (isPlaying) pauseTimer();
      else startTimer();
    });

    stepBtn?.addEventListener('click', () => {
      pauseTimer();
      nextStep();
    });

    resetBtn?.addEventListener('click', () => {
      pauseTimer();
      renderStep(1);
    });

    // Initialise
    switchMode('flywheel');
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      startTimer();
    } else {
      pauseTimer();
    }
  })();
</script>


---
import { BASE } from '../data/site';
---

<section class="landing-flow" data-component="landing-flow" data-base={BASE} aria-labelledby="flow-heading">
  <!-- Top Navigation Bar: Modes & Status -->
  <div class="flow-top-bar">
    <div class="flow-mode-switch" role="group" aria-label="Tooling philosophy scenario">
      <button type="button" class="mode-btn active" data-mode="flywheel">
        <span class="mode-icon">⚡</span>
        <span class="mode-text">The Flywheel</span>
      </button>
      <button type="button" class="mode-btn" data-mode="hamster">
        <span class="mode-icon">🔄</span>
        <span class="mode-text">Hamster Wheel</span>
      </button>
    </div>

    <div class="flow-live-pill" data-live-pill>
      <span class="pulse-dot"></span>
      <span class="live-label" data-live-label>FLYWHEEL ACTIVE</span>
    </div>
  </div>

  <!-- Stepper Navigation: 4 Steps in a Horizontal Row -->
  <div class="flow-stepper" role="tablist" aria-label="Flywheel sequence steps">
    <button type="button" class="step-tab active" data-step-target="1" role="tab" aria-selected="true">
      <span class="tab-num">01</span>
      <span class="tab-label" data-tab-label="1">Notice</span>
    </button>
    <button type="button" class="step-tab" data-step-target="2" role="tab" aria-selected="false">
      <span class="tab-num">02</span>
      <span class="tab-label" data-tab-label="2">Steer</span>
    </button>
    <button type="button" class="step-tab" data-step-target="3" role="tab" aria-selected="false">
      <span class="tab-num">03</span>
      <span class="tab-label" data-tab-label="3">Prove</span>
    </button>
    <button type="button" class="step-tab" data-step-target="4" role="tab" aria-selected="false">
      <span class="tab-num">04</span>
      <span class="tab-label" data-tab-label="4">Compound</span>
    </button>
  </div>

  <!-- Interactive Terminal / Workbench Stage -->
  <div class="stage-window">
    <div class="window-header">
      <div class="window-dots" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <div class="window-title-group">
        <span class="window-icon" data-window-icon>📋</span>
        <span class="window-title" data-window-title>Monday Ingest (Messy statements)</span>
      </div>
      <span class="window-badge badge-ok" data-window-badge>WEEK 1: RAW INGEST</span>
    </div>

    <div class="window-viewport" data-window-viewport>
      <pre class="window-pre"><code class="window-code" data-window-code>Loading simulation...</code></pre>
    </div>
  </div>

  <!-- Narrative Context Card -->
  <div class="narrative-card">
    <div class="narrative-role-chip" data-narrative-role>ROLE: PRODUCT MANAGER</div>
    <p class="narrative-body" data-narrative-text>
      Sam notices 40 receipts from Mina's candle shop with mixed formats (EUR, euro) and a repeated delivery line. Instead of retyping rows every Monday, Sam treats friction as a specification.
    </p>
  </div>

  <!-- Bottom Playback Controls Bar -->
  <div class="flow-bottom-bar">
    <div class="playback-controls">
      <button type="button" class="ctrl-btn" data-action="toggle-playback">
        <span class="ctrl-icon" data-play-icon>⏸</span>
        <span data-play-text>Pause</span>
      </button>
      <button type="button" class="ctrl-btn" data-action="step-playback">
        <span>Next Step ⏭</span>
      </button>
      <button type="button" class="ctrl-btn" data-action="reset-playback">
        <span>Restart ↺</span>
      </button>
    </div>

    <div class="flow-guide-link">
      <a href={`${BASE}/method/be-the-product-manager-of-your-own-tooling/`} data-guide-link>
        Product Manager method →
      </a>
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('[data-component="landing-flow"]');
    if (!root) return;

    const base = root.getAttribute('data-base') || '';
    const modeBtns = root.querySelectorAll('[data-mode]');
    const stepTabs = root.querySelectorAll('[data-step-target]');
    const liveLabel = root.querySelector('[data-live-label]');
    const livePill = root.querySelector('[data-live-pill]');
    const windowIcon = root.querySelector('[data-window-icon]');
    const windowTitle = root.querySelector('[data-window-title]');
    const windowBadge = root.querySelector('[data-window-badge]');
    const windowCode = root.querySelector('[data-window-code]');
    const narrativeRole = root.querySelector('[data-narrative-role]');
    const narrativeText = root.querySelector('[data-narrative-text]');
    const playBtn = root.querySelector('[data-action="toggle-playback"]');
    const playIcon = root.querySelector('[data-play-icon]');
    const playText = root.querySelector('[data-play-text]');
    const stepBtn = root.querySelector('[data-action="step-playback"]');
    const resetBtn = root.querySelector('[data-action="reset-playback"]');
    const guideLink = root.querySelector('[data-guide-link]');

    let currentMode = 'flywheel';
    let currentStep = 1;
    let isPlaying = true;
    let timer = null;

    const scenarios = {
      flywheel: {
        pillLabel: 'FLYWHEEL ACTIVE',
        linkText: 'Product Manager method →',
        linkHref: 'method/be-the-product-manager-of-your-own-tooling/',
        tabs: ['Notice', 'Steer', 'Prove', 'Compound'],
        steps: [
          {
            icon: '📋',
            title: 'Raw Ingest: 40 Receipts',
            badge: 'RAW INGEST',
            badgeClass: 'badge-ok',
            role: 'ROLE: PRODUCT MANAGER',
            narrative: 'Sam notices 40 receipts from Mina\'s candle shop with mixed formats (EUR, €, euro) and a repeated delivery charge. Instead of manually retyping rows into Excel every week, Sam treats this friction as a specification.',
            code: [
              '# Raw Monday Ingest (Messy statements):',
              '1. Candles EUR 120.00',
              '2. Glass jars €85.00',
              '3. Wicks 40 euro',
              '4. Delivery EUR 120.00  [⚠️ duplicate line?]',
              '5. Wax supplies EUR 210.00',
              '',
              'Current state: Manual courier copying rows into Excel'
            ].join('\n')
          },
          {
            icon: '💬',
            title: 'User Brief: Outcome Spec',
            badge: 'SPECIFICATION',
            badgeClass: 'badge-ok',
            role: 'ROLE: PRODUCT MANAGER → TECH LEAD',
            narrative: 'Sam does not write Python or regular expressions. Sam tells the assistant: "Clean up currency symbols, calculate distinct totals, and halt with exit code 1 if any row duplicates." The assistant takes ownership of the technical plan.',
            code: [
              '# User Brief to Assistant (Tech Lead):',
              'Goal: Parse monthly shop invoices without manual cleanup.',
              'Rules:',
              '  1. Normalise EUR, euro, and € to standard float.',
              '  2. Halt immediately if any item description + amount duplicates.',
              '  3. Mina reads the summary: no technical jargon.',
              'Check:',
              '  Write an isolated unit test and prove it catches the duplicate.'
            ].join('\n')
          },
          {
            icon: '⚙️',
            title: 'Worktree: Test Gate',
            badge: 'GATE PASS: 0',
            badgeClass: 'badge-ok',
            role: 'ROLE: TECH LEAD (ASSISTANT)',
            narrative: 'The assistant works in an isolated git worktree. It writes a 12-line parser, proves it fails on the duplicate delivery line (the red run), and verifies all checks pass before asking Sam for sign-off.',
            code: [
              '# Assistant Output (Tested in isolated branch):',
              '$ python3 test_invoice_cleaner.py',
              '  [TEST 1] Currency normalisation (€/EUR/euro) -> PASS',
              '  [TEST 2] Duplicate line detection -> PASS (caught Row 4)',
              '',
              'CLEAN INVOICE REPORT:',
              '  1. Candles: €120.00 | 2. Glass jars: €85.00 | 3. Wicks: €40.00',
              '  [!] STOP: Row 4 ("Delivery EUR 120.00") flagged as duplicate.',
              '  Distinct Net Total: €455.00 | Proof exit code: 0'
            ].join('\n')
          },
          {
            icon: '⚡',
            title: 'Next Monday: Autonomous Run',
            badge: 'ZERO RE-PROMPT',
            badgeClass: 'badge-ok',
            role: 'THE MAGIC: SIMULATE NEXT WEEK',
            narrative: 'Sam keeps the tool. Next Monday, 52 fresh invoices arrive. Sam does not open a chat window. The retained micro-tool parses them instantly, catches a supplier duplicate, and outputs the clean tie-out in two hundredths of a second.',
            code: [
              '# Next Monday: 52 fresh receipts loaded automatically',
              '$ ./tools/clean_invoices.py --input receipts_nov.csv',
              '',
              '✓ 52 lines ingested in 0.02s',
              '✓ 3 currency formats normalised to €',
              '⚠️ ANOMALY DETECTED: Row 19 repeats Row 4 ("Wicks €40.00")',
              '✓ Net total reconciled: €1,840.00',
              '',
              'Compounding dividend: Zero prompt fatigue. 45 minutes saved weekly.'
            ].join('\n')
          }
        ]
      },
      hamster: {
        pillLabel: 'HAMSTER WHEEL',
        linkText: 'Why prompt engineering fails →',
        linkHref: 'start-here/why-bother/',
        tabs: ['Vague Ask', 'Silent Slip', 'Review Tax', 'Reset'],
        steps: [
          {
            icon: '💬',
            title: 'Raw Chat (No Harness)',
            badge: 'NO HARNESS',
            badgeClass: 'badge-warn',
            role: 'ROLE: THE MANUAL COURIER',
            narrative: 'Sam pastes 40 invoice lines directly into ChatGPT with the prompt: "Total these bills please and split 3 ways." There are no schemas, no mechanical checks, and no sandboxes.',
            code: [
              'User prompt:',
              '"Total these bills please and split 3 ways for my shop"',
              '',
              'Pasted lines:',
              'Candles EUR 120, Glass jars €85, Wicks 40 euro, Delivery EUR 120...',
              '',
              'Risk: Model has no external tools or tie-out checks.'
            ].join('\n')
          },
          {
            icon: '⚠️',
            title: 'Confident Reply (Wrong)',
            badge: 'SILENT DRIFT',
            badgeClass: 'badge-warn',
            role: 'SYCOPHANCY IN ACTION',
            narrative: 'The assistant sounds entirely confident. It missed "Wicks 40 euro" because of the unusual format, and silently summed the duplicate delivery row. Without a mechanical check, Sam would overpay suppliers.',
            code: [
              'Assistant Reply:',
              '"Here is your clean summary! Everything looks great!',
              'Total expenses: €325.00 | Each share: €108.33"',
              '',
              'REALITY CHECK:',
              '  - Completely dropped "Wicks 40 euro" line',
              '  - Included duplicate "Delivery EUR 120" line without warning',
              '  - Arithmetic was wrong by €130.00'
            ].join('\n')
          },
          {
            icon: '😫',
            title: 'Chat Disagreement',
            badge: 'FATIGUE TAX',
            badgeClass: 'badge-warn',
            role: 'ROLE: OVERWORKED HUMAN LINTER',
            narrative: 'Sam spots the error and starts arguing: "Wait, you missed the wicks!" The assistant apologises profusely, adjusts one line, but drops another rule. Sam ends up checking every row with a calculator anyway.',
            code: [
              'User: "Wait, you missed the wicks! And delivery was paid twice!"',
              'Assistant: "My apologies! You are completely right! Let me recalculate..."',
              'Assistant: "The revised total is €485.00..." (Now missed Glass jars)',
              '',
              'Result: Sam opens Excel and recalculates by hand.',
              'Comprehension debt: High. Trust: Destroyed.'
            ].join('\n')
          },
          {
            icon: '🔁',
            title: 'Next Monday (Reset)',
            badge: 'ZERO RETENTION',
            badgeClass: 'badge-warn',
            role: 'THE 80% CALCULATOR TRAP',
            narrative: 'Next Monday brings 50 new receipts. Because Sam treated the assistant as a faster chat keyboard rather than an autonomous toolbuilder, zero tooling was retained. Sam faces the exact same manual chore again.',
            code: [
              '# Next Monday arrives...',
              'Retained micro-tools: 0',
              'Automated test gates: 0',
              'Permanent memory: None',
              '',
              'Process: Open new chat box, paste new prompt, pray for luck.',
              'Compounding dividend: 0%. The hamster wheel keeps spinning.'
            ].join('\n')
          }
        ]
      }
    };

    function renderStep(stepIndex) {
      const scenario = scenarios[currentMode];
      const data = scenario.steps[stepIndex - 1];
      if (!data) return;

      currentStep = stepIndex;

      // Update Header Text & Pill
      if (liveLabel) liveLabel.textContent = scenario.pillLabel;
      if (livePill) {
        livePill.classList.toggle('pill-fault', currentMode === 'hamster');
      }
      if (guideLink) {
        guideLink.textContent = scenario.linkText;
        guideLink.setAttribute('href', `${base}/${scenario.linkHref}`);
      }

      // Update Window Header & Code
      if (windowIcon) windowIcon.textContent = data.icon;
      if (windowTitle) windowTitle.textContent = data.title;
      if (windowBadge) {
        windowBadge.textContent = data.badge;
        windowBadge.classList.remove('badge-ok', 'badge-warn');
        windowBadge.classList.add(data.badgeClass);
      }
      if (windowCode) windowCode.textContent = data.code;

      // Update Narrative Card
      if (narrativeRole) narrativeRole.textContent = data.role;
      if (narrativeText) narrativeText.textContent = data.narrative;

      // Update Stepper Tabs
      stepTabs.forEach((tab, idx) => {
        const s = idx + 1;
        const isActive = s === currentStep;
        tab.classList.toggle('active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');

        const labelEl = tab.querySelector('[data-tab-label]');
        if (labelEl && scenario.tabs[idx]) {
          labelEl.textContent = scenario.tabs[idx];
        }
      });
    }

    function switchMode(mode) {
      currentMode = mode;
      currentStep = 1;
      modeBtns.forEach((b) => {
        b.classList.toggle('active', b.getAttribute('data-mode') === mode);
      });
      renderStep(1);
    }

    function nextStep() {
      const next = currentStep >= 4 ? 1 : currentStep + 1;
      renderStep(next);
    }

    function startTimer() {
      if (timer) clearInterval(timer);
      isPlaying = true;
      if (playIcon) playIcon.textContent = '⏸';
      if (playText) playText.textContent = 'Pause';
      timer = setInterval(nextStep, 6000);
    }

    function pauseTimer() {
      if (timer) clearInterval(timer);
      timer = null;
      isPlaying = false;
      if (playIcon) playIcon.textContent = '▶';
      if (playText) playText.textContent = 'Play';
    }

    // Event Bindings
    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-mode') || 'flywheel';
        switchMode(mode);
      });
    });

    stepTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        pauseTimer();
        const s = Number(tab.getAttribute('data-step-target')) || 1;
        renderStep(s);
      });
    });

    playBtn?.addEventListener('click', () => {
      if (isPlaying) pauseTimer();
      else startTimer();
    });

    stepBtn?.addEventListener('click', () => {
      pauseTimer();
      nextStep();
    });

    resetBtn?.addEventListener('click', () => {
      pauseTimer();
      renderStep(1);
    });

    // Initialise
    switchMode('flywheel');
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      startTimer();
    } else {
      pauseTimer();
    }
  })();
</script>

<style>
  .landing-flow {
    margin-top: 0;
    padding: 1.15rem;
    background: var(--ahg-panel);
    border: 1px solid var(--ahg-line);
    border-radius: var(--ahg-radius-card);
    box-shadow: 0 4px 24px rgb(0 0 0 / 0.08);
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  /* Top Bar */
  .flow-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--ahg-line);
    box-sizing: border-box;
    width: 100%;
    min-height: 44px;
    height: 44px;
    max-height: 44px;
  }

  .flow-mode-switch {
    display: flex;
    gap: 0.35rem;
    flex-wrap: nowrap;
  }

  .mode-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 32px;
    padding: 0.2rem 0.6rem;
    background: var(--ahg-bg);
    border: 1px solid var(--ahg-line);
    border-radius: var(--ahg-radius-control);
    color: var(--ahg-muted);
    font-size: 0.74rem;
    font-weight: 700;
    cursor: pointer;
    box-sizing: border-box;
    white-space: nowrap;
    transition: all 0.15s ease-out;
  }

  .mode-btn:hover {
    color: var(--ahg-text);
    border-color: var(--ahg-accent);
  }

  .mode-btn.active {
    background: var(--ahg-accent-soft);
    border-color: var(--ahg-accent);
    color: var(--ahg-accent-strong);
    box-shadow: inset 0 0 0 1px var(--ahg-accent);
  }

  .flow-live-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--ahg-right);
    text-transform: uppercase;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .flow-live-pill.pill-fault {
    color: var(--ahg-wrong);
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
    animation: livePulse 2s infinite ease-in-out;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.85); }
  }

  /* Stepper Navigation: 4 Horizontal Tabs */
  .flow-stepper {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4rem;
    margin-bottom: 0.85rem;
    width: 100%;
    box-sizing: border-box;
  }

  .step-tab {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    height: 38px;
    min-height: 38px;
    padding: 0.2rem 0.4rem;
    background: var(--ahg-bg);
    border: 1px solid var(--ahg-line);
    border-radius: var(--ahg-radius-control);
    cursor: pointer;
    text-align: center;
    box-sizing: border-box;
    overflow: hidden;
    min-width: 0;
    transition: all 0.15s ease-out;
  }

  .step-tab:hover {
    border-color: var(--ahg-accent);
  }

  .step-tab.active {
    background: var(--ahg-accent-soft);
    border-color: var(--ahg-accent);
    box-shadow: 0 0 0 1px var(--ahg-accent);
  }

  .tab-num {
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--ahg-muted);
    flex-shrink: 0;
  }

  .step-tab.active .tab-num {
    color: var(--ahg-accent-strong);
  }

  .tab-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ahg-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .step-tab.active .tab-label {
    color: var(--ahg-accent-strong);
  }

  /* Stage Window: Clean Terminal / Code Viewport */
  .stage-window {
    display: flex;
    flex-direction: column;
    background: var(--ahg-bg);
    border: 1px solid var(--ahg-line);
    border-radius: var(--ahg-radius-card);
    height: 330px;
    min-height: 330px;
    max-height: 330px;
    margin-bottom: 0.85rem;
    box-sizing: border-box;
    overflow: hidden;
    width: 100%;
  }

  .window-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    height: 36px;
    min-height: 36px;
    padding: 0 0.75rem;
    background: var(--ahg-panel);
    border-bottom: 1px solid var(--ahg-line);
    box-sizing: border-box;
    flex-shrink: 0;
  }

  .window-dots {
    display: flex;
    gap: 5px;
    flex-shrink: 0;
  }

  .window-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ahg-line);
  }

  .window-title-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    overflow: hidden;
    min-width: 0;
    flex: 1 1 auto;
  }

  .window-icon {
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .window-title {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--ahg-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .window-badge {
    font-size: 0.64rem;
    font-weight: 800;
    padding: 0.15rem 0.45rem;
    border-radius: var(--ahg-radius-control);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    flex-shrink: 0;
    white-space: nowrap;
    line-height: 1.2;
  }

  .badge-ok {
    background: var(--ahg-right-soft);
    color: var(--ahg-right);
    border: 1px solid var(--ahg-right);
  }

  .badge-warn {
    background: var(--ahg-wrong-soft);
    color: var(--ahg-wrong);
    border: 1px solid var(--ahg-wrong);
  }

  .window-viewport {
    flex: 1;
    padding: 0.75rem;
    overflow-y: auto;
    overflow-x: auto;
    background: var(--ahg-panel);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8rem;
    line-height: 1.45;
    box-sizing: border-box;
  }

  .window-pre {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .window-code {
    color: var(--ahg-text);
  }

  /* Narrative Card */
  .narrative-card {
    background: var(--ahg-bg);
    border: 1px solid var(--ahg-line);
    border-radius: var(--ahg-radius-control);
    padding: 0.75rem 0.85rem;
    min-height: 118px;
    height: 118px;
    max-height: 118px;
    margin-bottom: 0.85rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.25rem;
    overflow-y: auto;
    width: 100%;
  }

  .narrative-role-chip {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--ahg-accent-strong);
    flex-shrink: 0;
  }

  .narrative-body {
    margin: 0;
    font-size: 0.76rem;
    color: var(--ahg-text);
    line-height: 1.42;
  }

  /* Bottom Controls Bar */
  .flow-bottom-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.65rem;
    min-height: 34px;
    height: 34px;
    max-height: 34px;
    box-sizing: border-box;
    width: 100%;
  }

  .playback-controls {
    display: flex;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .ctrl-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 30px;
    padding: 0.2rem 0.55rem;
    background: var(--ahg-bg);
    border: 1px solid var(--ahg-line);
    border-radius: var(--ahg-radius-control);
    color: var(--ahg-text);

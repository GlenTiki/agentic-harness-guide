<script>
  (() => {
    const root = document.querySelector('[data-diagram="end-to-end-flow"]');
    if (!root) return;

    const filterBtns = root.querySelectorAll('[data-flow-filter]');
    const steps = root.querySelectorAll('.flow-step');
    const faultBtn = root.querySelector('[data-action="test-fault"]');
    const target = root.querySelector('.fault-target');
    const titleEl = root.querySelector('.readout-title');
    const descEl = root.querySelector('.readout-desc');

    let currentFilter = 'all';

    const render = (faulted = false) => {
      filterBtns.forEach((btn) => {
        btn.classList.toggle('active', btn.getAttribute('data-flow-filter') === currentFilter && !faulted);
      });

      steps.forEach((step) => {
        const st = step.getAttribute('data-layer-status');
        const match = currentFilter === 'all' || st === currentFilter;
        (step as HTMLElement).style.display = match ? '' : 'none';
      });

      if (faulted) {
        target?.classList.add('fault-active');
        if (titleEl && descEl) {
          titleEl.innerHTML = '<span class="badge-step badge-blocked">Loud failure</span> Layer 07 (Hooks) removed';
          descEl.textContent = 'Simulated fault: if the pre-tool write guard is missing, the stop hook halts the close and reports an unverified write. The harness catches the failure immediately!';
        }
      } else {
        target?.classList.remove('fault-active');
        if (titleEl && descEl) {
          titleEl.innerHTML = '<span class="badge-step">Pipeline</span> 16 layers from prompt to merge and memory';
          descEl.textContent = 'Every layer has an honest status label and hands verified data to the next step. Each layer is built to fail loudly when broken.';
        }
      }
    };

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentFilter = btn.getAttribute('data-flow-filter') || 'all';
        render(false);
      });
    });

    faultBtn?.addEventListener('click', () => {
      render(true);
      setTimeout(() => render(false), 2600);
    });

    render(false);
  })();
</script>


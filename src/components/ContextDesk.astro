    stroke: var(--ahg-accent);
    stroke-width: 1.5;
    stroke-dasharray: 6 4;
  }

  .sheet {
    fill: var(--ahg-panel);
    stroke: var(--ahg-line);
    stroke-width: 1.5;
    transition: transform var(--ahg-motion-fast) ease-out;
  }

  .hot {
    stroke: var(--ahg-accent);
    stroke-width: 2;
  }


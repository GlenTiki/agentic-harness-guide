<figure class="diagram" data-diagram="context-desk">
  <div class="diagram-toolbar" role="toolbar" aria-label="Context desk controls">
    <div class="btn-group" role="group" aria-label="Conversation turn selection">
      <button type="button" class="ctrl-btn active" data-turn="1">Turn 1: Clean desk</button>
      <button type="button" class="ctrl-btn" data-turn="20">Turn 20: Bills pasted</button>
      <button type="button" class="ctrl-btn" data-turn="140">Turn 140: Window fills</button>
      <button type="button" class="ctrl-btn" data-turn="compact">After compaction</button>
    </div>
  </div>

  <svg viewBox="0 0 480 250" role="img" aria-labelledby="cd-t cd-d" xmlns="http://www.w3.org/2000/svg">
    <title id="cd-t">The context window as a desk</title>
    <desc id="cd-d">A desk holds your messages, the assistant's replies and any pasted text. The assistant can use everything on the desk. Older text that no longer fits sits off the desk, where the assistant cannot see it.</desc>
    <defs>
      <marker id="cd-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" class="arrow" />
      </marker>
      <pattern id="cd-grid" width="20" height="20" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="1" class="grid-dot" />
      </pattern>
    </defs>

    <rect width="480" height="250" fill="url(#cd-grid)" opacity="0.4" rx="10" />

    <!-- Desk perimeter -->
    <rect x="20" y="20" width="300" height="194" rx="10" class="desk" />
    <text x="36" y="44" class="zhead desk-head">On the desk: the assistant sees this</text>

    <!-- Sheets on the desk -->
    <g class="sheet-group" data-sheet="msg">
      <rect x="40" y="60" width="120" height="52" rx="6" class="sheet hot" />
      <rect x="40" y="60" width="5" height="52" rx="2.5" class="sheet-accent" />
      <text x="100" y="91" class="label">Your message</text>
    </g>

    <g class="sheet-group" data-sheet="reply">
      <rect x="180" y="60" width="120" height="52" rx="6" class="sheet" />
      <rect x="180" y="60" width="5" height="52" rx="2.5" class="sheet-accent" />
      <text x="240" y="91" class="label">Its reply</text>
    </g>

    <g class="sheet-group" data-sheet="bills">
      <rect x="40" y="130" width="260" height="66" rx="6" class="sheet" />
      <rect x="40" y="130" width="5" height="66" rx="2.5" class="sheet-accent" />
      <text x="170" y="160" class="label">Pasted bills or article</text>
      <text x="170" y="180" class="sub" data-sub="bills">40 amounts for 39 months</text>
    </g>

    <!-- Sheets off the desk -->
    <g class="sheet-group gone-sheet" data-sheet="oldest">
      <rect x="350" y="60" width="110" height="52" rx="6" class="sheet gone" />
      <text x="405" y="91" class="label gone-label">Oldest text</text>
    </g>

    <g class="sheet-group gone-sheet" data-sheet="older">
      <rect x="350" y="130" width="110" height="52" rx="6" class="sheet gone" />
      <text x="405" y="160" class="label gone-label">Older still</text>
    </g>

    <text x="405" y="44" class="zhead mid">Off the desk</text>
    <text x="405" y="206" class="sub mid">not seen</text>

    <!-- Indicator arrow -->
    <path d="M346 120H326" class="line" marker-end="url(#cd-a)" />
  </svg>

  <div class="diagram-readout" aria-live="polite">
    <p class="readout-title"><span class="badge-step">Turn 1</span> Clean desk</p>
    <p class="readout-desc">The session starts with your initial prompt and the loaded instruction file. Ample context tokens remain.</p>
  </div>

  <figcaption>When the desk is full, older text falls off. The assistant cannot use what is off the desk.</figcaption>
</figure>

<script>
  (() => {
    const root = document.querySelector('[data-diagram="context-desk"]');
    if (!root) return;

    const states = {
      1: {
        title: 'Turn 1: Clean desk',
        desc: 'The session opens with your task and instruction rules on the desk. All prior turns are empty.',
        billsSub: 'Empty desk, standing rules loaded',
      },
      20: {
        title: 'Turn 20: Bills pasted',
        desc: 'You paste 39 months of bills. The table sits in full view on the desk where the assistant can inspect every row.',
        billsSub: '40 amounts for 39 months (in view)',
      },
      140: {
        title: 'Turn 140: Context window fills',
        desc: 'After 140 turns of tool calls and code editing, older messages fall off the desk into unreadable memory.',
        billsSub: 'Older turns evicted off desk',
      },
      compact: {
        title: 'After compaction: Ledger saves the rule',
        desc: 'The harness replaces evicted chat turns with a brief summary. Crucial rules survived only if pinned in a durable ledger file!',
        billsSub: 'Compacted summary + durable ledger',
      },
    };

    let currentTurn = '1';
    const titleEl = root.querySelector('.readout-title');
    const descEl = root.querySelector('.readout-desc');
    const billsSubEl = root.querySelector('[data-sub="bills"]');
    const btns = root.querySelectorAll('[data-turn]');
    const goneSheets = root.querySelectorAll('.gone-sheet');

    const render = () => {
      btns.forEach((btn) => {
        const t = btn.getAttribute('data-turn');
        btn.classList.toggle('active', t === currentTurn);
        btn.setAttribute('aria-pressed', t === currentTurn ? 'true' : 'false');
      });

      goneSheets.forEach((s) => {
        if (currentTurn === '1') s.style.opacity = '0.2';
        else if (currentTurn === '20') s.style.opacity = '0.5';
        else s.style.opacity = '1';
      });

      const s = states[currentTurn];
      if (titleEl && descEl && s) {
        titleEl.innerHTML = `<span class="badge-step">${s.title.split(':')[0]}</span> ${s.title.split(':')[1] || ''}`;
        descEl.textContent = s.desc;
        if (billsSubEl) billsSubEl.textContent = s.billsSub;
      }
    };

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentTurn = btn.getAttribute('data-turn') || '1';
        render();
      });
    });

    render();
  })();
</script>

<style>

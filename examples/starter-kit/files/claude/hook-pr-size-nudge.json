{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}/.claude/hooks/pr_size_nudge.py\"; [ -f \"$f\" ] || exit 0; python3 -I \"$f\""
          }
        ]
      }
    ]
  }
}
